# Shared by all HA nodes (back + horizon). Secrets must match RAFT_NOTIFY_* on each raft.
HA_ENABLED=true
HA_NODE_SECRET=changeme-ha-secret
RAFT_URL=http://raft:8000
# Raft node id → that node's backend via host-published nginx ports (simulates production peer reachability).
HA_PEER_URLS=node1=http://host.docker.internal:8083,node2=http://host.docker.internal:8183,node3=http://host.docker.internal:8283
