# Shared by all HA nodes (back + horizon). Secrets must match RAFT_NOTIFY_* on each raft.
HA_ENABLED=true
HA_NODE_SECRET=changeme-ha-secret
RAFT_URL=http://raft:8000
# Raft advertise address → that node's nginx (container_name on skylogs_ha).
HA_PEER_URLS=172.28.7.11=http://nginx-1:80,172.28.7.12=http://nginx-2:80,172.28.7.13=http://nginx-3:80
