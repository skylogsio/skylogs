FROM php:8.4-fpm-alpine

# Match back image timezone
RUN rm -rf /etc/localtime && ln -s /usr/share/zoneinfo/Asia/Tehran /etc/localtime

# Runtime tools (dcron for schedule:run); app code comes from shared app_data volume
RUN apk add --no-cache curl git dcron unzip

ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /root
RUN chmod +x /root/install-php-extensions && /root/install-php-extensions curl \
                           fileinfo \
                           gd \
                           intl \
                           json \
                           mbstring \
                           bcmath \
                           mysqli \
                           openssl \
                           pcntl \
                           pdo_mysql \
                           redis \
                           soap \
                           mongodb \
                           sockets \
                           xml \
                           zip
RUN rm /root/install-php-extensions
RUN rm -rf /tmp/* /var/cache/apk/*

COPY horizon-crontab /etc/cron.d/horizon-cron
RUN chmod 0644 /etc/cron.d/horizon-cron && crontab /etc/cron.d/horizon-cron

COPY horizon-entrypoint.sh /usr/local/bin/horizon-entrypoint.sh
RUN chmod +x /usr/local/bin/horizon-entrypoint.sh

WORKDIR /var/www/html

CMD ["/bin/sh", "/usr/local/bin/horizon-entrypoint.sh"]
