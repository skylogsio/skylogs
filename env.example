# Copy to .env and adjust. `.env` should be gitignored.
#
# COMPOSE_PROFILES controls which optional components start.
#   (empty)          -> single zone, no clustering  [default]
#   ha               -> Raft HA cluster inside the zone
#   multizone        -> Sentinel cross-zone federation
#   ha,multizone     -> both

# ---------------------------------------------------------------------------
# Default: single node, no clustering, no federation
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=
RAFT_ENABLED=false
SENTINEL_ENABLED=false


# ---------------------------------------------------------------------------
# Raft HA — uncomment together with `ha` in COMPOSE_PROFILES
# ---------------------------------------------------------------------------
# IMAGE_TAG_RAFT=skylogsio/skylogs-raft:latest
# RAFT_ENABLED=true
# RAFT_HTTP_URL=http://skylogs-raft:8000
# RAFT_BIND_ADDR=skylogs-raft:7000
# Node-specific settings (NODE_ID, peer list, bootstrap flag) go in raft.env


# ---------------------------------------------------------------------------
# Sentinel multi-zone — uncomment together with `multizone` in COMPOSE_PROFILES
# ---------------------------------------------------------------------------
# IMAGE_TAG_SENTINEL=skylogsio/skylogs-sentinel:latest
# SENTINEL_ENABLED=true
# SENTINEL_ID=dc2-sentinel
# SENTINEL_ROLE=secondary
# MAIN_SKYLOGS_HEARTBEAT_URL=http://nginx_back:80/heartbeat
# ALERT_WEBHOOK_URL=http://nginx_back:80/internal/alerts/sentinel
# HEARTBEAT_INTERVAL=5s
# HEARTBEAT_TIMEOUT=3s
# FAIL_THRESHOLD=3

