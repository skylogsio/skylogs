# Copy to .env to override docker-compose.yml. A missing .env still boots:
# Compose uses the same defaults written below. Do not leave APP_KEY, JWT_SECRET,
# or NEXTAUTH_SECRET empty — an empty value replaces the default.
# Change those secrets before any shared or production deploy.
#   php artisan key:generate --show
#   openssl rand -hex 32
#   openssl rand -base64 32

# ---- Images (published stack only) ----
IMAGE_TAG_BACK=skylogsio/skylogs-api:latest
IMAGE_TAG_FRONT=skylogsio/skylogs-frontend:latest
IMAGE_TAG_SENTINEL=skylogsio/skylogs-sentinel:latest
IMAGE_TAG_RAFT=skylogsio/skylogs-raft:latest

# ---- Which extra services start on `docker compose up -d` ----
# ha, multizone, or ha,multizone. Leave empty for a single node.
# Front and back always start; these profiles only add Raft / Sentinel.
COMPOSE_PROFILES=

# ---- URLs ----
# API is published on 80. The UI is published on 3000.
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
BASE_URL=http://nginx/api/v1/
APP_DEBUG=true
DEPLOY_TYPE=web

# ---- Secrets (local defaults) ----
APP_KEY=base64:bG9jYWwtZGV2LW9ubHktYXBwLWtleS1jaGFuZ2UhISE=
JWT_SECRET=local-dev-jwt-secret-change-me-32b
NEXTAUTH_SECRET=local-dev-nextauth-secret-change-me

# ---- MongoDB ----
# Leave username and password empty for the local database with no auth.
# Set both together to enable auth. The API container must be built from
# this repo so it sends authSource (DB_AUTHENTICATION_DATABASE).
DB_CONNECTION=mongodb
DB_HOST=mongo
DB_PORT=27017
DB_DATABASE=Skylogs
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
DB_AUTHENTICATION_DATABASE=admin

# ---- Redis ----
# Leave empty for local Redis with no auth.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_CACHE_DB=2

# ---- High availability ----
# Set HA_ENABLED=true together with COMPOSE_PROFILES=ha.
HA_ENABLED=false
HA_NODE_ID=node1
HA_NODE_SECRET=local-dev-ha-secret
RAFT_URL=http://raft:8000
RAFT_NODE_ID=node1
RAFT_ADV_ADDR=raft
RAFT_START_MODE=--bootstrap
RAFT_NOTIFY_URL=http://nginx:80/api/ha/apply

# ---- Sentinel ----
# Leave id and role empty to keep apps/sentinel/config.yaml values.
# Copy apps/sentinel/config.example.yaml to config.yaml before multizone.
# Set COMPOSE_PROFILES=multizone to start the sentinel container.
SENTINEL_ID=
SENTINEL_ROLE=
MAIN_SENTINEL_URL=
ALERT_BASE_URL=http://nginx
HEARTBEAT_INTERVAL=5s
HEARTBEAT_TIMEOUT=3s
HEARTBEAT_FAIL_AFTER=15s
